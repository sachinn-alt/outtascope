# ==============================================================
# OuttaScope Environment Configuration
# ==============================================================

# Server Port
PORT=8000

# Open-Source AI Model Engine (Gemma 2)
# Option 1: Local Ollama (100% Free & Offline)
OLLAMA_BASE_URL=http://localhost:11434
GEMMA_MODEL_NAME=gemma2

# Option 2: Cloud Gemma 2 API (Optional, e.g. Groq / Google AI Studio)
# GEMMA_API_KEY=your_gemma_api_key_here
# GROQ_API_KEY=gsk_your_groq_api_key_here

# Tiger Data PostgreSQL Database Connection
# If left blank, OuttaScope automatically uses local SQLite persistence
# TIGER_DATABASE_URL=postgresql://user:password@cloud.tigerdata.com:5432/outtascope

# Local SQLite Database Path fallback
SQLITE_PATH=outtascope.db
